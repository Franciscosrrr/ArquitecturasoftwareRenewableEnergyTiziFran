{
  "openapi": "3.0.3",
  "info": {
    "title": "ArquitecturasoftwareRenewableEnergy - Calculadora invitada",
    "version": "1.0.1",
    "description": "Contrato web anónimo con mock local de consumo y Solar manual. Frontend y servicios productivos pendientes. Sin JWT/API key ni persistencia de consumos/estudios. Ver docs/GUEST-MODE.md."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Mock local ejecutable en localhost después de iniciar scripts/compose; no es un despliegue productivo."
    }
  ],
  "tags": [
    {
      "name": "Invitado",
      "description": "Cálculos temporales sin cuenta"
    }
  ],
  "paths": {
    "/api/v1/publico/consumo": {
      "post": {
        "tags": [
          "Invitado"
        ],
        "operationId": "estimarConsumoInvitado",
        "summary": "Estimar energía de un conjunto de equipos y hábitos",
        "description": "Mismas validaciones y reglas consumo-v1; cálculo sin persistencia, sin sesión ni API key. ids únicos; diasUso <= diasPeriodo; precisión decimal y salidas a seis decimales. Límites y privacidad en GUEST-MODE.md.",
        "security": [],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Correlación opcional; si se omite, se genera un identificador. No es clave de idempotencia.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudEstimacion"
              },
              "examples": {
                "consumoMixto": {
                  "value": {
                    "diasPeriodo": 30,
                    "equipos": [
                      {
                        "id": "iluminacion",
                        "modo": "POTENCIA",
                        "cantidad": 4,
                        "potenciaW": 10,
                        "horasPorDia": 5,
                        "diasUso": 30,
                        "factorFuncionamiento": 1
                      },
                      {
                        "id": "heladera",
                        "modo": "POTENCIA",
                        "cantidad": 1,
                        "potenciaW": 150,
                        "horasPorDia": 24,
                        "diasUso": 30,
                        "factorFuncionamiento": 0.3
                      },
                      {
                        "id": "lavarropas",
                        "modo": "CICLOS",
                        "cantidad": 1,
                        "energiaPorCicloKWh": 0.75,
                        "ciclosPeriodo": 12
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estimación calculada sin crear lugares, configuraciones o evaluaciones persistentes.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de correlación de la operación.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoEstimacion"
                },
                "examples": {
                  "consumoMixto": {
                    "summary": "Potencia y ciclos en un período de 30 días",
                    "value": {
                      "versionAlgoritmo": "consumo-v1",
                      "diasPeriodo": 30,
                      "desglose": [
                        {
                          "id": "iluminacion",
                          "energiaPeriodoKWh": 6
                        },
                        {
                          "id": "heladera",
                          "energiaPeriodoKWh": 32.4
                        },
                        {
                          "id": "lavarropas",
                          "energiaPeriodoKWh": 9
                        }
                      ],
                      "totalPeriodoKWh": 47.4,
                      "promedioDiarioKWh": 1.58,
                      "supuestos": [
                        "Estimación basada en equipos y hábitos declarados; no es una medición real.",
                        "El factor de funcionamiento se aplica una sola vez."
                      ],
                      "traceId": "entrega1-ejemplo-001"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo no contiene JSON válido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "FORMATO_INVALIDO",
                  "mensaje": "El cuerpo no contiene JSON válido.",
                  "traceId": "entrega1-ejemplo-400",
                  "detalles": []
                }
              }
            }
          },
          "413": {
            "description": "La solicitud supera 256 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "CUERPO_DEMASIADO_GRANDE",
                  "mensaje": "La solicitud supera 256 KiB.",
                  "traceId": "entrega1-ejemplo-413",
                  "detalles": []
                }
              }
            }
          },
          "415": {
            "description": "Utilice Content-Type application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "TIPO_CONTENIDO_NO_SOPORTADO",
                  "mensaje": "Utilice Content-Type application/json.",
                  "traceId": "entrega1-ejemplo-415",
                  "detalles": []
                }
              }
            }
          },
          "422": {
            "description": "Los datos de consumo no cumplen las reglas de la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "VALIDACION",
                  "mensaje": "Los datos de consumo no cumplen las reglas de la operación.",
                  "traceId": "entrega1-ejemplo-002",
                  "detalles": [
                    {
                      "campo": "equipos[0].diasUso",
                      "motivo": "No puede superar diasPeriodo (30)."
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Se alcanzó el límite anónimo por origen; Retry-After indica cuándo reintentar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "LIMITE_DE_TRAFICO",
                  "mensaje": "Se alcanzó el límite anónimo por origen.",
                  "traceId": "entrega1-ejemplo-429",
                  "detalles": []
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Espera sugerida en segundos. Obligatorio en 429; opcional en 503 si se conoce.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "No fue posible completar la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "ERROR_INTERNO",
                  "mensaje": "No fue posible completar la operación.",
                  "traceId": "entrega1-ejemplo-500",
                  "detalles": []
                }
              }
            }
          },
          "503": {
            "description": "La capacidad no está disponible temporalmente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "SERVICIO_NO_DISPONIBLE",
                  "mensaje": "La capacidad no está disponible temporalmente.",
                  "traceId": "entrega1-ejemplo-503",
                  "detalles": []
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Espera sugerida en segundos. Obligatorio en 429; opcional en 503 si se conoce.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/publico/recomendaciones-solares": {
      "post": {
        "tags": [
          "Invitado"
        ],
        "operationId": "recomendarSolarInvitado",
        "summary": "Recomendar paneles sin guardar estudio",
        "description": "Lee paneles activos y recurso; mismas reglas solar-v1 del flujo durable. Ordena alternativas por el criterio indicado; la primera es la recomendación. Cantidad ceil(objetivo/generación por panel); superficie limita factibilidad. Si nadie cumple, SIN_ALTERNATIVA presenta mayor cobertura alcanzable primero. coberturaAlcanzada es fracción, puede superar 1; cero consumo -> cero. Nunca guarda documentos ni eventos. Deadline 8 s; fuente indisponible 503. Body 256 KiB; 10/minuto por origen, ráfaga 2. Máximo 20 alternativas; totalAlternativas y alternativasTruncadas describen el conjunto antes del truncamiento.",
        "security": [],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Correlación opcional; si se omite, se genera un identificador. No es clave de idempotencia.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudSolarTemporal"
              },
              "examples": {
                "manual": {
                  "value": {
                    "promedioDiarioKWh": 1.58,
                    "coberturaObjetivo": 1,
                    "rendimientoGlobal": 0.8,
                    "superficieUtilM2": 10,
                    "recursoSolar": {
                      "tipo": "MANUAL",
                      "hsp": 4,
                      "fuente": "Valor declarado para ejemplo, no medido"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado temporal; SIN_ALTERNATIVA también usa 200. Sin estudioId ni persistencia. Para demanda cero, cantidad/generación/cobertura son cero y cumpleObjetivo=true; sin paneles activos se devuelve lista vacía.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoSolarTemporal"
                },
                "examples": {
                  "manual": {
                    "value": {
                      "estado": "COMPLETADO",
                      "versionAlgoritmo": "solar-v1",
                      "alternativas": [
                        {
                          "panelId": "panel-demo-500",
                          "modelo": "Panel ilustrativo 500 W",
                          "versionFicha": 1,
                          "cantidad": 1,
                          "generacionDiariaKWh": 1.6,
                          "coberturaAlcanzada": 1.012658,
                          "superficieRequeridaM2": 2.5,
                          "cumpleObjetivo": true
                        }
                      ],
                      "totalAlternativas": 1,
                      "alternativasTruncadas": false,
                      "criterioSeleccion": "MENOR_SUPERFICIE",
                      "fuenteRecurso": "Manual: Valor declarado para ejemplo, no medido",
                      "hsp": 4,
                      "supuestos": [
                        "Catálogo de ejemplo: único panel activo, 500 W, superficie efectiva 2,5 m², sin precio.",
                        "Cobertura es balance energético; no autonomía horaria."
                      ],
                      "traceId": "invitado-ejemplo-001"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo no contiene JSON válido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "FORMATO_INVALIDO",
                  "mensaje": "El cuerpo no contiene JSON válido.",
                  "traceId": "entrega1-ejemplo-400",
                  "detalles": []
                }
              }
            }
          },
          "413": {
            "description": "La solicitud supera 256 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "CUERPO_DEMASIADO_GRANDE",
                  "mensaje": "La solicitud supera 256 KiB.",
                  "traceId": "entrega1-ejemplo-413",
                  "detalles": []
                }
              }
            }
          },
          "415": {
            "description": "Utilice Content-Type application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "TIPO_CONTENIDO_NO_SOPORTADO",
                  "mensaje": "Utilice Content-Type application/json.",
                  "traceId": "entrega1-ejemplo-415",
                  "detalles": []
                }
              }
            }
          },
          "422": {
            "description": "Los datos de consumo no cumplen las reglas de la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "VALIDACION",
                  "mensaje": "Los datos de consumo no cumplen las reglas de la operación.",
                  "traceId": "entrega1-ejemplo-002",
                  "detalles": [
                    {
                      "campo": "recursoSolar.hsp",
                      "motivo": "Debe ser mayor que 0 y menor o igual a 24."
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Se alcanzó el límite anónimo por origen; Retry-After indica cuándo reintentar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "LIMITE_DE_TRAFICO",
                  "mensaje": "Se alcanzó el límite anónimo por origen.",
                  "traceId": "entrega1-ejemplo-429",
                  "detalles": []
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Espera sugerida en segundos. Obligatorio en 429; opcional en 503 si se conoce.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "No fue posible completar la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "ERROR_INTERNO",
                  "mensaje": "No fue posible completar la operación.",
                  "traceId": "entrega1-ejemplo-500",
                  "detalles": []
                }
              }
            }
          },
          "503": {
            "description": "La capacidad no está disponible temporalmente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "SERVICIO_NO_DISPONIBLE",
                  "mensaje": "La capacidad no está disponible temporalmente.",
                  "traceId": "entrega1-ejemplo-503",
                  "detalles": []
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Espera sugerida en segundos. Obligatorio en 429; opcional en 503 si se conoce.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SolicitudEstimacion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "diasPeriodo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "equipos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/EquipoPotencia"
                },
                {
                  "$ref": "#/components/schemas/EquipoCiclos"
                }
              ],
              "discriminator": {
                "propertyName": "modo",
                "mapping": {
                  "POTENCIA": "#/components/schemas/EquipoPotencia",
                  "CICLOS": "#/components/schemas/EquipoCiclos"
                }
              }
            }
          }
        },
        "required": [
          "diasPeriodo",
          "equipos"
        ]
      },
      "EquipoPotencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Identificador del consumidor, único dentro de equipos; no es un id del catálogo interno."
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "modo": {
            "type": "string",
            "enum": [
              "POTENCIA"
            ]
          },
          "potenciaW": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 1000000,
            "exclusiveMinimum": true
          },
          "horasPorDia": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 24
          },
          "diasUso": {
            "type": "integer",
            "minimum": 0,
            "maximum": 366,
            "description": "Debe ser menor o igual a diasPeriodo."
          },
          "factorFuncionamiento": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 1,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "id",
          "modo",
          "cantidad",
          "potenciaW",
          "horasPorDia",
          "diasUso",
          "factorFuncionamiento"
        ]
      },
      "EquipoCiclos": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Identificador del consumidor, único dentro de equipos; no es un id del catálogo interno."
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "modo": {
            "type": "string",
            "enum": [
              "CICLOS"
            ]
          },
          "energiaPorCicloKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 1000,
            "exclusiveMinimum": true
          },
          "ciclosPeriodo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Cantidad de ciclos por unidad del equipo durante todo el período."
          }
        },
        "required": [
          "id",
          "modo",
          "cantidad",
          "energiaPorCicloKWh",
          "ciclosPeriodo"
        ]
      },
      "ConsumoEquipo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Identificador del consumidor, único dentro de equipos; no es un id del catálogo interno."
          },
          "energiaPeriodoKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double"
          }
        },
        "required": [
          "id",
          "energiaPeriodoKWh"
        ]
      },
      "ResultadoEstimacion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "versionAlgoritmo": {
            "type": "string",
            "enum": [
              "consumo-v1"
            ]
          },
          "diasPeriodo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "desglose": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ConsumoEquipo"
            }
          },
          "totalPeriodoKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double"
          },
          "promedioDiarioKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double"
          },
          "supuestos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "versionAlgoritmo",
          "diasPeriodo",
          "desglose",
          "totalPeriodoKWh",
          "promedioDiarioKWh",
          "supuestos",
          "traceId"
        ]
      },
      "DetalleError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "campo": {
            "type": "string",
            "minLength": 1
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "campo",
          "motivo"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string",
            "enum": [
              "FORMATO_INVALIDO",
              "NO_AUTENTICADO",
              "SIN_PERMISO",
              "CUERPO_DEMASIADO_GRANDE",
              "TIPO_CONTENIDO_NO_SOPORTADO",
              "VALIDACION",
              "LIMITE_DE_TRAFICO",
              "ERROR_INTERNO",
              "SERVICIO_NO_DISPONIBLE"
            ]
          },
          "mensaje": {
            "type": "string",
            "minLength": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleError"
            }
          }
        },
        "required": [
          "codigo",
          "mensaje",
          "traceId",
          "detalles"
        ]
      },
      "RecursoManual": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "hsp",
          "fuente"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "MANUAL"
            ]
          },
          "hsp": {
            "type": "number",
            "minimum": 0,
            "maximum": 24,
            "exclusiveMinimum": true
          },
          "fuente": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "RecursoUbicacion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "latitud",
          "longitud"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "UBICACION"
            ]
          },
          "latitud": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitud": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "SolicitudSolarTemporal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "promedioDiarioKWh",
          "coberturaObjetivo",
          "rendimientoGlobal",
          "recursoSolar"
        ],
        "properties": {
          "promedioDiarioKWh": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "coberturaObjetivo": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,

{
  "openapi": "3.0.3",
  "info": {
    "title": "Renewable Energy - cotización solar",
    "version": "1.1.0",
    "description": "API web separada de la capacidad M2M consumo 1.0.1. Proveedor simulado explícito en Compose; sin persistencia. Integración comercial 2026-11-11: ofertas reales con flete/descuento y respaldo simulado identificado. La capacidad de Clínica 1.0.1 se conserva."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway local."
    }
  ],
  "paths": {
    "/api/v1/publico/solar/cotizaciones": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "consumo",
                  "horasSolPico",
                  "factorRendimiento"
                ],
                "properties": {
                  "consumo": {
                    "$ref": "#/components/schemas/SolicitudCatalogo"
                  },
                  "horasSolPico": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 8,
                    "multipleOf": 1e-06
                  },
                  "factorRendimiento": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 1,
                    "multipleOf": 1e-06
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cotización comercial sin reserva ni compra.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "consumo",
                    "potenciaObjetivoW",
                    "cotizacion",
                    "modoProveedor",
                    "traceId"
                  ],
                  "properties": {
                    "consumo": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "totalPeriodoKWh",
                        "promedioDiarioKWh",
                        "diasPeriodo"
                      ],
                      "properties": {
                        "totalPeriodoKWh": {
                          "type": "number",
                          "minimum": 0
                        },
                        "promedioDiarioKWh": {
                          "type": "number",
                          "exclusiveMinimum": true,
                          "minimum": 0
                        },
                        "diasPeriodo": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 366
                        }
                      }
                    },
                    "potenciaObjetivoW": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000000
                    },
                    "cotizacion": {
                      "$ref": "#/components/schemas/Cotizacion"
                    },
                    "modoProveedor": {
                      "type": "string",
                      "enum": [
                        "simulado",
                        "externo"
                      ]
                    },
                    "traceId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{32}$"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "FORMATO_INVALIDO: JSON inválido, campos desconocidos o más de un objeto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "STOCK_INSUFICIENTE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "CUERPO_DEMASIADO_GRANDE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "TIPO_CONTENIDO_NO_SOPORTADO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDACION",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "LIMITE_DE_TRAFICO; respetar Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos mínimos antes de reintentar."
              }
            }
          },
          "500": {
            "description": "ERROR_INTERNO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "CONTRATO_PROVEEDOR_INVALIDO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PROVEEDOR_NO_DISPONIBLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "cotizarInstalacionSolar",
        "security": [],
        "description": "Solar vuelve a calcular el consumo por catálogo en Consumo; no acepta potencia ni energía arbitraria del navegador. potenciaObjetivoW=ceil(promedioDiarioKWh*1000/(horasSolPico*factorRendimiento)). Energía diaria positiva y <=100000 kWh; potencia objetivo <=10000000 W; parámetros de hasta seis decimales. Presupuesto de aplicación 4 s; Consumo 2.5 s y vendedor 1 s, sin reintentos automáticos. Cuerpo máximo 256 KiB. No reserva, compra ni guarda. Error de cotización no invalida la estimación de consumo ya calculada."
      }
    }
  },
  "components": {
    "schemas": {
      "SolicitudEstimacion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "diasPeriodo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "equipos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/EquipoPotencia"
                },
                {
                  "$ref": "#/components/schemas/EquipoCiclos"
                }
              ],
              "discriminator": {
                "propertyName": "modo",
                "mapping": {
                  "POTENCIA": "#/components/schemas/EquipoPotencia",
                  "CICLOS": "#/components/schemas/EquipoCiclos"
                }
              }
            }
          }
        },
        "required": [
          "diasPeriodo",
          "equipos"
        ]
      },
      "EquipoPotencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Identificador del consumidor, Ãºnico dentro de equipos; no es un id del catÃ¡logo interno."
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "modo": {
            "type": "string",
            "enum": [
              "POTENCIA"
            ]
          },
          "potenciaW": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 1000000,
            "exclusiveMinimum": true
          },
          "horasPorDia": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 24
          },
          "diasUso": {
            "type": "integer",
            "minimum": 0,
            "maximum": 366,
            "description": "Debe ser menor o igual a diasPeriodo."
          },
          "factorFuncionamiento": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 1,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "id",
          "modo",
          "cantidad",
          "potenciaW",
          "horasPorDia",
          "diasUso",
          "factorFuncionamiento"
        ]
      },
      "EquipoCiclos": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Identificador del consumidor, Ãºnico dentro de equipos; no es un id del catÃ¡logo interno."
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "modo": {
            "type": "string",
            "enum": [
              "CICLOS"
            ]
          },
          "energiaPorCicloKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double",
            "maximum": 1000,
            "exclusiveMinimum": true
          },
          "ciclosPeriodo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Cantidad de ciclos por unidad del equipo durante todo el perÃ­odo."
          }
        },
        "required": [
          "id",
          "modo",
          "cantidad",
          "energiaPorCicloKWh",
          "ciclosPeriodo"
        ]
      },
      "ConsumoEquipo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Identificador del consumidor, Ãºnico dentro de equipos; no es un id del catÃ¡logo interno."
          },
          "energiaPeriodoKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double"
          }
        },
        "required": [
          "id",
          "energiaPeriodoKWh"
        ]
      },
      "ResultadoEstimacion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "versionAlgoritmo": {
            "type": "string",
            "enum": [
              "consumo-v1"
            ]
          },
          "diasPeriodo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "desglose": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ConsumoEquipo"
            }
          },
          "totalPeriodoKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double"
          },
          "promedioDiarioKWh": {
            "type": "number",
            "minimum": 0,
            "format": "double"
          },
          "supuestos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "versionAlgoritmo",
          "diasPeriodo",
          "desglose",
          "totalPeriodoKWh",
          "promedioDiarioKWh",
          "supuestos",
          "traceId"
        ]
      },
      "DetalleError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "campo": {
            "type": "string",
            "minLength": 1
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "campo",
          "motivo"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string",
            "enum": [
              "FORMATO_INVALIDO",
              "NO_AUTENTICADO",
              "SIN_PERMISO",
              "CUERPO_DEMASIADO_GRANDE",
              "TIPO_CONTENIDO_NO_SOPORTADO",
              "VALIDACION",
              "LIMITE_DE_TRAFICO",
              "ERROR_INTERNO",
              "SERVICIO_NO_DISPONIBLE"
            ]
          },
          "mensaje": {
            "type": "string",
            "minLength": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleError"
            }
          }
        },
        "required": [
          "codigo",
          "mensaje",
          "traceId",
          "detalles"
        ]
      },
      "Ficha": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "modo": {
            "type": "string",
            "enum": [
              "POTENCIA",
              "CICLOS"
            ]
          },
          "potenciaW": {
            "type": "number",
            "minimum": 0
          },
          "energiaPorCicloKWh": {
            "type": "number",
            "minimum": 0
          },
          "factorFuncionamiento": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0,
            "maximum": 1
          },
          "fuente": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "nombre",
          "categoria",
          "modo",
          "potenciaW",
          "energiaPorCicloKWh",
          "factorFuncionamiento",
          "fuente",
          "version"
        ]
      },
      "SolicitudCatalogo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "diasPeriodo",
          "equipos"
        ],
        "properties": {
          "diasPeriodo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "equipos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cantidad": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "horasPorDia": {
                      "type": "number",
                      "minimum": 0,
                      "format": "double",
                      "maximum": 24
                    },
                    "diasUso": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 366,
                      "description": "Debe ser menor o igual a diasPeriodo."
                    },
                    "factorFuncionamiento": {
                      "type": "number",
                      "minimum": 0,
                      "format": "double",
                      "maximum": 1,
                      "exclusiveMinimum": true
                    },
                    "catalogoId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_-]+$",
                      "description": "Identificador de una ficha activa del catálogo propio."
                    }
                  },
                  "required": [
                    "cantidad",
                    "horasPorDia",
                    "diasUso",
                    "factorFuncionamiento",
                    "catalogoId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cantidad": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "ciclosPeriodo": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000,
                      "description": "Cantidad de ciclos por unidad del equipo durante todo el perÃ­odo."
                    },
                    "catalogoId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_-]+$",
                      "description": "Identificador de una ficha activa del catálogo propio."
                    }
                  },
                  "required": [
                    "cantidad",
                    "ciclosPeriodo",
                    "catalogoId"
                  ]
                }
              ]
            }
          }
        }
      },
      "PaginaCatalogo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "pagina",
          "tamano"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ficha"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "tamano": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "Cotizacion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cotizacionId",
          "sku",
          "potenciaPanelW",
          "cantidad",
          "stockDisponible",
          "precioUnitarioCentavos",
          "totalCentavos",
          "moneda"
        ],
        "properties": {
          "cotizacionId": {
            "type": "string",
            "minLength": 0,
            "maxLength": 64,
            "description": "Vacío para ofertas reales: el proveedor no persiste una cotización. Solo el simulador asigna una identidad didáctica."
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "potenciaPanelW": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "stockDisponible": {
            "type": "integer",
            "minimum": 0
          },
          "precioUnitarioCentavos": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "totalCentavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "moneda": {
            "type": "string",
            "enum": [
              "ARS"
            ]
          },
          "origen": {
            "type": "string",
            "enum": [
              "externo",
              "simulado"
            ]
          },
          "motivoSimulacion": {
            "type": "string",
            "maxLength": 64
          },
          "skuProveedor": {
            "type": "string",
            "maxLength": 64
          },
          "proveedorId": {
            "type": "integer",
            "minimum": 1
          },
          "proveedorNombre": {
            "type": "string",
            "maxLength": 200
          },
          "referenciaProveedor": {
            "type": "string",
            "maxLength": 128
          },
          "fleteCentavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "descuentoPorcentaje": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "descuentoAplicado": {
            "type": "boolean"
          },
          "consultadoEn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Importes en centavos ARS adaptados con precisión decimal. En origen externo el total informado incluye flete y descuento aplicado; no se impone precio unitario por cantidad. La oferta es una foto del momento, sin reserva ni precio congelado."
      }
    }
  }
}

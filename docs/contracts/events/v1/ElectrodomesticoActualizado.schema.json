{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tipo": {
      "const": "ElectrodomesticoActualizado.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "eventId",
    "id",
    "tipo",
    "version"
  ]
}
